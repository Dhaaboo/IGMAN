@page "/dashboard"

<PageTitle>IGMAN Dashboard</PageTitle>

<div class="igman-dashboard">

    <aside class="sidebar">

        <div class="brand">
            <div class="brand-icon">I</div>
            <span>IGMAN</span>
        </div>

        <nav>
            <a href="/dashboard">⌂ Dashboard</a>
            <a href="/api-status">⚡ API Status</a>
            <a href="#">🧠 AI Brain</a>
            <a href="#">💬 Chat</a>
            <a href="#">🎤 Voice</a>
            <a href="#">🌐 Web Research</a>
            <a href="#">💻 Coding</a>
            <a href="#">📊 Data Analysis</a>
            <a href="#">👁 Vision</a>
            <a href="#">🧠 Memory</a>
            <a href="#">⚙ Settings</a>
        </nav>

    </aside>

    <main class="main-content">

        <header class="topbar">
            <div>
                <span class="status-dot"></span>
                IGMAN ONLINE
            </div>

            <div class="user-area">
                Somaliland 🇸🇴
            </div>
        </header>

        <section class="hero">

            <div class="hero-content">
                <p class="eyebrow">AI ASSISTANT</p>

                <h1>
                    Hello, I'm <span>IGMAN</span>
                </h1>

                <p>
                    Your intelligent AI assistant for conversation,
                    research, coding, data and vision.
                </p>

                <div class="actions">
                    <button>Start Conversation</button>
                    <button class="secondary">🎤 Voice</button>
                </div>
            </div>

            <div class="ai-core">
                <div class="core-ring">
                    <div class="core">I</div>
                </div>

                <p>AI CORE</p>
            </div>

        </section>

        <section class="cards">

            <div class="card">
                <h3>🧠 AI Brain</h3>
                <p>Reasoning and conversation engine.</p>
            </div>

            <div class="card">
                <h3>🌐 Web Research</h3>
                <p>Search and understand information online.</p>
            </div>

            <div class="card">
                <h3>💻 Coding</h3>
                <p>Write, analyze and debug code.</p>
            </div>

            <div class="card">
                <h3>👁 Vision</h3>
                <p>Computer vision and image understanding.</p>
            </div>

        </section>

    </main>

</div>